{
  "name": "glide",
  "version": "1.0.0",
  "description": "A fluid, glass sidebar for Windows: clipboard history, capture tools, a file shelf, todos and now playing.",
  "productName": "Glide",
  "author": "Leon Lin",
  "license": "MIT",
  "homepage": "https://github.com/Leonxlnx/glide#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leonxlnx/glide.git"
  },
  "bugs": {
    "url": "https://github.com/Leonxlnx/glide/issues"
  },
  "private": true,
  "main": "electron/main.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "node node_modules/vite/bin/vite.js build --config vite.config.mjs",
